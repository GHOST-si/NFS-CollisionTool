<Window x:Class="CollisionTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="860"
        Width="740"
        WindowStyle="ToolWindow"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="NFS Collision Tool"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

                <TextBlock x:Name="TxtVersion"
                       FontSize="13"
                       Margin="0,5,0,15"
                       Foreground="#A0A0A0"/>

                <TextBlock Text="Collision Bound Viewer &amp; Editor"
                       FontSize="18"
                       Foreground="White"/>

                <Separator Margin="0,15"/>

                <TextBlock Text="Description:"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"/>

                <TextBlock Text="A visual .bin collision editor for NFS Most Wanted (2005) and Carbon (experimental), with live 3D preview and raw-field editing."
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,6,0,8"
                       Foreground="White"/>

                <Separator Margin="0,15"/>

                <TextBlock Text="Features:"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,3,0,0"
                       Foreground="White"/>

                <TextBlock Text="• Import/Export .bin collision files"
                       FontSize="14"
                       Margin="0,5,0,0"
                       Foreground="White"/>

                <TextBlock Text="• Move or resize bounds directly in the 3D view"
                       FontSize="14"
                       Foreground="White"/>

                <TextBlock Text="• Full raw field editor, with bound hierarchy"
                       FontSize="14"
                       Foreground="White"/>

                <TextBlock Text="• Add/delete bounds and clouds, with a Resolve panel for broken references"
                       FontSize="14"
                       Foreground="White"/>

                <TextBlock Text="• Undo/Redo"
                       FontSize="14"
                       Foreground="White"/>

                <TextBlock Text="• Supports Binarius and Binary .bin files"
                       FontSize="14"
                       Foreground="White"/>

                <TextBlock Text="• Optional reference 3D car model overlay"
                       FontSize="14"
                       Foreground="White"/>

                <Separator Margin="0,15"/>

                <TextBlock Text="Created by GHOST-si"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#B0B0B0"/>

                <TextBlock Text="© 2026"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#B0B0B0"/>
                
                <TextBlock FontSize="14" Margin="0,8,0,0" Foreground="#B0B0B0">
                  <Hyperlink NavigateUri="https://github.com/GHOST-si/NFS-CollisionTool"
                  RequestNavigate="Hyperlink_RequestNavigate"
                  Foreground="#7CB7FF">github.com/GHOST-si/NFS-CollisionTool</Hyperlink>
                </TextBlock>

                <Separator Margin="0,15"/>

                <TextBlock Text="Third-Party Notices:"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"/>

                <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,6,0,4"
                       Foreground="#B0B0B0">
                <Run Text="• Microsoft Edge WebView2 Runtime - © Microsoft Corporation, used under Microsoft's WebView2 distribution terms."/>
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,4"
                       Foreground="#B0B0B0">
                <Run Text="• three.js, OrbitControls.js, OBJLoader.js - © three.js authors, MIT License (see LICENSE-three.js.txt). These libraries are bundled unmodified and embedded into the generated viewer."/>
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,8"
                       Foreground="#B0B0B0">
                <Run Text="• Python (embedded) - © Python Software Foundation, PSF License (see the license file in the Python folder)."/>
                </TextBlock>

                <Separator Margin="0,15"/>

                <TextBlock Text="Acknowledgements:"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"/>

                <TextBlock Text="Collision file format research was informed by the NFS: Most Wanted decompilation project (github.com/dbalatoni13/nfsmw), Binary/Binarius, and other publicly available Need for Speed modding resources. Third-party components included with this tool are listed above."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,6,0,8"
                       Foreground="#B0B0B0"/>

                <TextBlock Text="An LLM was used to accelerate the UI/core integration and as a research aid."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,8"
                       Foreground="#B0B0B0"/>

                <TextBlock Text="Disclaimer: this is an unofficial, fan-made community tool. It is not affiliated with, endorsed by or sponsored by Electronic Arts Inc. or its subsidiaries. Need for Speed and related names are trademarks of Electronic Arts Inc. No game files or game code are included."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,8"
                       Foreground="#B0B0B0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>
